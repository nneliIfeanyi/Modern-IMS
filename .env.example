APP_NAME=IMS
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/IMS/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pharm_ims
DB_USERNAME=root
DB_PASSWORD=

# SMS notifications (leave EBULKSMS_API_URL empty to disable provider delivery)
EBULKSMS_API_URL=
EBULKSMS_USERNAME=
EBULKSMS_API_KEY=
EBULKSMS_SENDER_ID=IMS
SMS_LOW_STOCK_RECIPIENTS=
SMS_EXPIRY_RECIPIENTS=
SMS_PAYMENT_ALERTS=true
EXPIRY_TRACKING_ENABLED=false

# WhatsApp webhook (use a random verify token and the Meta app secret)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# WhatsApp Cloud API (use a supported Graph API version and an approved utility template)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PO_TEMPLATE_NAME=
WHATSAPP_PO_TEMPLATE_LANGUAGE=en_US
